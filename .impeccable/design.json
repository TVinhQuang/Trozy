      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:var(--foreground,#273142);font:600 13px/1.5 \"Segoe UI\",sans-serif}.ds-field input{min-height:44px;padding:10px 12px;border:1px solid var(--control-border,#818d9d);border-radius:9px;background:var(--surface,#fff);color:var(--foreground,#273142);font:400 14px/1.65 \"Segoe UI\",sans-serif;caret-color:var(--accent-text,#2154a2);transition:border-color 160ms,box-shadow 160ms}.ds-field input::placeholder{color:var(--muted,#5e6878);opacity:1}.ds-field input:focus{outline:none;border-color:var(--focus,#23539a);box-shadow:0 0 0 3px var(--ring-focus,#23539a26)}.ds-field input:disabled{background:var(--secondary,#f1f3f7);color:var(--muted,#5e6878)}"
