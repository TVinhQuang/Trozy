  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary task action with a fresh light-blue fill and readable dark-blue label.",
      "html": "<button class=\"ds-button-primary\">Thêm phòng</button>",
      "css": ".ds-button-primary{min-height:42px;padding:10px 16px;border:1px solid;border-radius:9px;font:600 13px/1.5 \"Segoe UI\",sans-serif;cursor:pointer;transition:background 160ms,border-color 160ms;background:var(--primary,#c8ddff);color:var(--primary-foreground,#163e73);border-color:var(--primary-border,#4879bc)}.ds-button-primary:hover,.ds-button-primary:active{background:var(--primary-hover,#b6d2ff);color:var(--primary-foreground,#163e73);border-color:var(--accent-text,#2154a2)}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#23539a);outline-offset:3px}.ds-button-primary:disabled{opacity:1;background:var(--secondary,#f1f3f7);color:var(--muted,#5e6878);border-color:var(--control-border,#818d9d);cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Lower-priority action on a quiet surface.",
      "html": "<button class=\"ds-button-secondary\">Hủy</button>",
      "css": ".ds-button-secondary{min-height:42px;padding:10px 16px;border:1px solid;border-radius:9px;font:600 13px/1.5 \"Segoe UI\",sans-serif;cursor:pointer;transition:background 160ms,border-color 160ms;border-color:var(--control-border,#818d9d);background:var(--secondary,#f1f3f7);color:var(--foreground,#273142)}.ds-button-secondary:hover{border-color:var(--primary-border,#4879bc)}.ds-button-secondary:active{background:var(--primary-light,#edf4ff)}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#23539a);outline-offset:3px}.ds-button-secondary:disabled{opacity:1;background:var(--secondary,#f1f3f7);color:var(--muted,#5e6878);border-color:var(--control-border,#818d9d);cursor:not-allowed}"
