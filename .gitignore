# Generated test output; reviewed test evidence belongs in docs/test
.coverage
.coverage.*
htmlcov/
.nyc_output/
/coverage/
/playwright-report/
/test-results/
/src/**/coverage/
/src/**/playwright-report/
/src/**/test-results/

# Local runtime cache and temporary working directories
.cache/
/logs/
/tmp/
/temp/

# Keep dependency lockfiles, course documents, PA archives, images,
# SQL scripts and datasets versioned unless a specific rule above applies.
