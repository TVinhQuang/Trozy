# Node.js 24+; all values below are local development defaults.
PORT=3001
HOST=127.0.0.1
TROZY_DB_PATH=data/trozy.sqlite
TROZY_SEED_DEMO=true
# Set true behind HTTPS in deployment.
TROZY_SECURE_COOKIES=false
# Optional SMTP delivery. Without these values, auth mail is saved locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TROZY_PUBLIC_URL=http://127.0.0.1:3001
# B01, B04 and UC16 use Gemini. On Workers set GEMINI_API_KEY as a secret.
# Use a billing-enabled Google project for real contracts or other personal data.
TROZY_AI_ENABLED=true
GEMINI_API_KEY=
# Optional extra comma-separated keys for key rotation.
GEMINI_API_KEYS=
# Comma-separated models rotated automatically on 429/503/404.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest
# failover: stay on healthy model until rate-limited then rotate; round_robin: advance every request.
TROZY_GEMINI_ROTATION_MODE=failover
TROZY_GEMINI_TIMEOUT_MS=45000
TROZY_GEMINI_COOLDOWN_MS=65000
# Tier-2 Vision fallback for automatic meter proposals when local OCR is uncertain or disabled (auto|gemini|off).
TROZY_METER_VISION_FALLBACK=auto
# Automatic mechanical-meter proposals; reuses the project-local CPU runtime.
# A landlord confirms layout once and reviews each proposed reading before saving.
# No inference downloads. Missing runtime leaves Gemini fallback (if configured) and manual image verification available.
TROZY_METER_READER_ENABLED=true
TROZY_METER_READER_TIMEOUT_MS=30000
