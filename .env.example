# Node.js 24+; all values below are local development defaults.
PORT=3001
HOST=127.0.0.1
TROZY_DB_PATH=data/trozy.sqlite
TROZY_SEED_DEMO=true
# Set true behind HTTPS in deployment.
TROZY_SECURE_COOKIES=false
# Optional SMTP delivery. Without these values, auth mail is saved locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TROZY_PUBLIC_URL=http://127.0.0.1:3001
# Local AI only: no API key or paid/cloud model is required.
OLLAMA_HOST=http://127.0.0.1:11434
TROZY_AI_MODEL=qwen3:4b-instruct
TROZY_AI_ENABLED=true
TROZY_AI_AUTO_START=true
TROZY_AI_TIMEOUT_MS=60000
# Automatic mechanical-meter proposals; reuses the project-local CPU runtime.
# A landlord confirms layout once and reviews each proposed reading before saving.
# No inference downloads. Missing runtime leaves manual image verification available.
TROZY_METER_READER_ENABLED=true
TROZY_METER_READER_TIMEOUT_MS=30000
